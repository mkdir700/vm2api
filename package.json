{
  "name": "vm2api",
  "private": true,
  "description": "VM-fidelity subscription-to-API gateway",
  "type": "module",
  "main": "src/server.mjs",
  "scripts": {
    "start": "node src/server.mjs",
    "test": "npm run test:unit && npm run test:go",
    "test:unit": "node scripts/run-isolated-tests.mjs test/unit .test.mjs",
    "test:e2e": "node scripts/run-isolated-tests.mjs test/e2e .e2e.test.mjs",
    "test:node": "npm run test:unit",
    "test:go": "cd worker && go test -race ./...",
    "test:all": "npm run test:unit && npm run test:go",
    "build:worker": "mkdir -p bin && cd worker && CGO_ENABLED=0 go build -trimpath -o ../bin/kin-worker ./cmd/kin-worker",
    "build:egress": "mkdir -p bin && cd worker && CGO_ENABLED=0 go build -trimpath -o ../bin/kin-egress ./cmd/kin-egress",
    "build:gate": "mkdir -p bin && cd worker && CGO_ENABLED=0 go build -trimpath -o ../bin/kin-slot-gate ./cmd/kin-slot-gate",
    "build:web": "pnpm -C web build",
    "fetch:payload": "node scripts/fetch-payload.mjs",
    "test:web": "pnpm -C web test",
    "format": "biome format --write && gofmt -w worker && pnpm -C web format",
    "format:check": "biome format && node scripts/check-gofmt.mjs && pnpm -C web format:check",
    "test:cache": "node --test test/e2e/native-system-cache.e2e.test.mjs test/e2e/native-server-environment.e2e.test.mjs test/e2e/session-cache.e2e.test.mjs test/e2e/compaction-cache.e2e.test.mjs",
    "test:cache:native": "node scripts/test-cache-native.mjs",
    "test:cache:live": "python3 test/e2e/repeated-request-native.e2e.py --growing-context --live --model claude-sonnet-4-6"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.1",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "croner": "^10.0.1",
    "https-proxy-agent": "^9.1.0",
    "node-fetch": "^2.7.0",
    "socks-proxy-agent": "^10.1.0",
    "ssh2": "^1.17.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
