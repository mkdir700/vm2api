# 在 http 作用域加载专用文件。该文件由发布器原子替换。
include /etc/nginx/truerouter-app.conf;
# truerouter-app.conf 的完整内容必须为：
# upstream truerouter_app { server 127.0.0.1:3330; }

# 在 sub2api 的现有 server/location 中使用：
# proxy_pass http://truerouter_app;
# 在 vm2api 的现有 server/location 中使用：
# proxy_pass http://127.0.0.1:8790;
# 保留既有 TLS、认证、超时和流式设置。

# 以下 location 加入已有的 TLS server。不要记录请求正文。
location = /internal/rollout/events {
    proxy_pass http://127.0.0.1:8791/events;
    client_max_body_size 64k;
}
location /internal/rollout/events/ {
    proxy_pass http://127.0.0.1:8791/events/;
}
