{
  "schema": 1,
  "state_dir": "/var/lib/truerouter-rollout/tasks",
  "lock_file": "/var/lib/truerouter-rollout/production.lock",
  "secret_file": "/etc/truerouter-rollout/control-token",
  "gateway_url": "http://127.0.0.1:8790",
  "node_bin": "/opt/node/bin/node",
  "ready_timeout_seconds": 60,
  "drain_timeout_seconds": 600,
  "gateway_authority_dir": "/opt/truerouter/authority",
  "gateway_env": "/etc/truerouter-rollout/gateway.env",
  "gateway_port": 8790,
  "gateway_active": "gateway-blue",
  "gateway_profiles": [
    {
      "id": "gateway-blue",
      "instance": "gateway-blue-bootstrap",
      "container": "truerouter-gateway-blue",
      "admin_url": "http://127.0.0.1:8792",
      "admin_port": 8792
    },
    {
      "id": "gateway-green",
      "instance": "gateway-green-bootstrap",
      "container": "truerouter-gateway-green",
      "admin_url": "http://127.0.0.1:8793",
      "admin_port": 8793
    }
  ],
  "profiles": [
    {
      "id": "group-blue",
      "instance": "group-blue-bootstrap",
      "project": "truerouter-blue",
      "url": "http://127.0.0.1:8787",
      "port": 8787,
      "service_env": "/etc/truerouter-rollout/blue.env",
      "authority_dir": "/opt/truerouter/authority",
      "resources": {
        "root": "/opt/truerouter/groups/blue",
        "accounts": [
          "REPLACE_DISTINCT_ACCOUNT_BLUE"
        ],
        "containers": [
          "truerouter-control-blue",
          "REPLACE_SLOT_CONTAINER_GROUP_BLUE"
        ]
      }
    },
    {
      "id": "group-green",
      "instance": "group-green-bootstrap",
      "project": "truerouter-green",
      "url": "http://127.0.0.1:8788",
      "port": 8788,
      "service_env": "/etc/truerouter-rollout/green.env",
      "authority_dir": "/opt/truerouter/authority",
      "resources": {
        "root": "/opt/truerouter/groups/green",
        "accounts": [
          "REPLACE_DISTINCT_ACCOUNT_GREEN"
        ],
        "containers": [
          "truerouter-control-green",
          "REPLACE_SLOT_CONTAINER_GROUP_GREEN"
        ]
      }
    }
  ],
  "application_active": "app-blue",
  "app_profiles": [
    {
      "id": "app-blue",
      "instance": "app-blue-bootstrap",
      "project": "truerouter-app-blue",
      "url": "http://127.0.0.1:3330",
      "port": 3330,
      "network": "REPLACE_EXISTING_DATABASE_NETWORK",
      "service_env": "/etc/truerouter-rollout/application.env",
      "resources": {
        "root": "/opt/truerouter/apps/blue",
        "accounts": [],
        "containers": [
          "truerouter-app-blue"
        ]
      }
    },
    {
      "id": "app-green",
      "instance": "app-green-bootstrap",
      "project": "truerouter-app-green",
      "url": "http://127.0.0.1:3331",
      "port": 3331,
      "network": "REPLACE_EXISTING_DATABASE_NETWORK",
      "service_env": "/etc/truerouter-rollout/application.env",
      "resources": {
        "root": "/opt/truerouter/apps/green",
        "accounts": [],
        "containers": [
          "truerouter-app-green"
        ]
      }
    }
  ],
  "proxy_container": "REPLACE_OPENRESTY_CONTAINER",
  "proxy_binary": "nginx",
  "upstream_include": "/opt/truerouter/openresty/truerouter-app.conf"
}
