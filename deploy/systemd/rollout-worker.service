[Unit]
Description=TrueRouter rollout worker
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
TimeoutStartSec=infinity
User=root
UMask=0077
WorkingDirectory=/opt/truerouter-rollout/vm2api
ExecStart=/usr/bin/python3 /opt/truerouter-rollout/vm2api/deploy/rollout-agent.py work --config /etc/truerouter-rollout/agent.json
NoNewPrivileges=true
PrivateTmp=true
